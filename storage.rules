rules_version = '2';

// Cada usuário só lê/escreve a própria pasta de foto de perfil
// (fotos_perfil/{uid}/...) — mesma convenção de path do Match.
service firebase.storage {
  match /b/{bucket}/o {
    match /fotos_perfil/{usuarioId}/{arquivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == usuarioId;
    }
  }
}
