<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pedida em runtime na tela principal (ver TelaCaronasActivity) — só
         existe de verdade a partir do Android 13 (API 33); em versões
         antigas a permissão nem existe, notificação sempre aparece. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CaronasApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caronas">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Caronas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== Flavor usuario (Caronas: motorista/passageiro) ===== -->
        <activity
            android:name=".LoginCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CadastroCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TelaCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".ConfiguracoesCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".TermosPrivacidadeCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".OrientacoesAdminCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".EditarCadastroCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".OferecerCaronaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ConversasCaronaActivity"
            android:exported="false" />
        <activity
            android:name=".ChatCaronaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PerfilPublicoActivity"
            android:exported="false" />
        <activity
            android:name=".EnviarManifestacaoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AssinaturaMotoristaActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Retorno do checkout do Mercado Pago (back_urls em
                 createPaymentPreferenceMotorista, functions/index.js). A
                 confirmação de verdade vem do webhook via Firestore — esse
                 deep link só traz o usuário de volta pro app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="caronasapp" android:host="payment_success" />
                <data android:scheme="caronasapp" android:host="payment_failure" />
                <data android:scheme="caronasapp" android:host="payment_pending" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaronasFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ===== Flavor admin (Admin Caronas) ===== -->
        <activity
            android:name=".LoginAdminCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CadastroAdminCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AdministracaoCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".BuscarAdminActivity"
            android:exported="false" />
        <activity
            android:name=".DetalhesUsuarioAdminActivity"
            android:exported="false" />
        <activity
            android:name=".RelatoriosCaronasActivity"
            android:exported="false" />

        <!-- Usado só pelo relatório em PDF do "Financeiro" (ver PdfUtil.kt/
             FinanceiroCaronasActivity) pra abrir o arquivo gerado no
             visualizador de PDF/WhatsApp/e-mail do aparelho. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
