<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Pedida em runtime na tela principal (ver TelaCaronasActivity) — só
         existe de verdade a partir do Android 13 (API 33); em versões
         antigas a permissão nem existe, notificação sempre aparece. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CaronasApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Caronas">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Caronas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== Flavor usuario (Caronas: motorista/passageiro) ===== -->
        <activity
            android:name=".LoginCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CadastroCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TelaCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".ConfiguracoesCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".TermosPrivacidadeCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".EditarCadastroCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".OferecerCaronaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ConversasCaronaActivity"
            android:exported="false" />
        <activity
            android:name=".ChatCaronaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PerfilPublicoActivity"
            android:exported="false" />

        <service
            android:name=".CaronasFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ===== Flavor admin (Admin Caronas) ===== -->
        <activity
            android:name=".LoginAdminCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CadastroAdminCaronasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AdministracaoCaronasActivity"
            android:exported="false" />
        <activity
            android:name=".BuscarAdminActivity"
            android:exported="false" />

    </application>

</manifest>
