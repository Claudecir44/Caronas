<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Caronas" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/azul_neon</item>
        <item name="colorPrimaryVariant">@color/azul_neon_escuro</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/azul_neon</item>
        <item name="colorSecondaryVariant">@color/azul_neon_escuro</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/fundo_escuro</item>
        <item name="android:windowBackground">@color/fundo_escuro</item>
    </style>

    <!-- Botões de ação da tela inicial (Procurar/Oferecer/Suas Viagens/Chat) —
         empilhados um abaixo do outro, do lado direito da área de perfil. -->
    <style name="BotaoAcaoCaronasVertical">
        <item name="android:layout_width">108dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/botao_azul_neon</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingHorizontal">3dp</item>
        <item name="android:paddingVertical">1dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Título pequeno, preto, alinhado à esquerda, que vai ACIMA de cada campo
         de digitação (repete o mesmo texto do hint que aparece dentro dele) —
         usado na tela Oferecer Carona. -->
    <!-- Título de seção da tela Minhas Ofertas ("Viagens Ofertadas" e
         "Solicitações Recebidas"): mesma letra, tamanho e cor nos dois. -->
    <style name="TituloSecaoCaronas">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="RotuloCampoCaronas">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

</resources>
