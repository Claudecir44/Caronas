<?xml version="1.0" encoding="utf-8"?>
<!-- Card de plano da tela de acesso pago: borda azul e fundo levemente azulado
     quando selecionado (view.isSelected), borda cinza quando não. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#EAF4FF" />
            <stroke android:width="2dp" android:color="@color/azul_neon" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#D0D5DB" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
