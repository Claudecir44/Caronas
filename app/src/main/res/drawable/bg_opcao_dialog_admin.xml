<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A1E90FF" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#1E90FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141E90FF" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#331E90FF" />
        </shape>
    </item>
</selector>
