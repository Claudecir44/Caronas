<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView porque abaixo do botão de pagar agora tem a lista "Meus
     pagamentos", que cresce a cada mês pago. fillViewport mantém o conteúdo
     centralizado quando a lista é curta. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza_claro"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚗"
        android:textSize="48sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_titulo"
        android:textColor="@color/azul_neon"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_explicacao"
        android:textColor="#555555"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/cardPlanoMensal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_plano_motorista"
        android:padding="16dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plano_motorista_mensal_titulo"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/plano_motorista_mensal_prazo"
                android:textColor="#777777"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/plano_motorista_mensal_preco"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardPlanoTrimestral"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_plano_motorista"
        android:padding="16dp"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plano_motorista_trimestral_titulo"
                android:textColor="#222222"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/plano_motorista_trimestral_prazo"
                android:textColor="#777777"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/plano_motorista_trimestral_economia"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/plano_motorista_trimestral_preco"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/btnPagarAssinaturaMotorista"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/assinatura_motorista_botao_pagar"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/botao_azul_neon" />

    <!-- Só aparece quando o acesso atual ainda tem mais de 2 dias: o botão
         acima fica desabilitado e aqui diz a partir de quando dá pra renovar. -->
    <TextView
        android:id="@+id/tvAvisoRenovacaoMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#B26A00"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutAguardandoConfirmacaoMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assinatura_motorista_aguardando"
            android:textColor="#555555"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- ========== MEUS PAGAMENTOS ========== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="10dp"
        android:text="@string/assinatura_motorista_meus_pagamentos"
        android:textColor="#222222"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSemPagamentosMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_sem_pagamentos"
        android:textColor="#888888"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/containerMeusPagamentosMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>

</ScrollView>
