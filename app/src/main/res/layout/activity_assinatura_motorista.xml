<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView porque abaixo do botão de pagar agora tem a lista "Meus
     pagamentos", que cresce a cada mês pago. fillViewport mantém o conteúdo
     centralizado quando a lista é curta. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza_claro"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚗"
        android:textSize="48sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_titulo"
        android:textColor="@color/azul_neon"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_explicacao"
        android:textColor="#555555"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_preco"
        android:textColor="#222222"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_prazo"
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnPagarAssinaturaMotorista"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/assinatura_motorista_botao_pagar"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/botao_azul_neon" />

    <!-- Só aparece quando o acesso atual ainda tem mais de 2 dias: o botão
         acima fica desabilitado e aqui diz a partir de quando dá pra renovar. -->
    <TextView
        android:id="@+id/tvAvisoRenovacaoMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#B26A00"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutAguardandoConfirmacaoMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assinatura_motorista_aguardando"
            android:textColor="#555555"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- ========== MEUS PAGAMENTOS ========== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="10dp"
        android:text="@string/assinatura_motorista_meus_pagamentos"
        android:textColor="#222222"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSemPagamentosMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_sem_pagamentos"
        android:textColor="#888888"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/containerMeusPagamentosMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>

</ScrollView>
