<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_cinza_claro"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚗"
        android:textSize="48sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_titulo"
        android:textColor="@color/azul_neon"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_explicacao"
        android:textColor="#555555"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_preco"
        android:textColor="#222222"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/assinatura_motorista_prazo"
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btnPagarAssinaturaMotorista"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/assinatura_motorista_botao_pagar"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/botao_azul_neon" />

    <LinearLayout
        android:id="@+id/layoutAguardandoConfirmacaoMotorista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assinatura_motorista_aguardando"
            android:textColor="#555555"
            android:textSize="13sp"
            android:gravity="center" />

    </LinearLayout>

</LinearLayout>
