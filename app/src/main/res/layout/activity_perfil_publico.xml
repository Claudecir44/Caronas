<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_cinza_claro">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/perfil_publico_titulo"
        android:textColor="@color/azul_neon"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="12dp" />

    <ProgressBar
        android:id="@+id/progressBarPerfilPublico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPerfilPublico"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/white"
                android:padding="20dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivFotoPerfilPublico"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_person_default"
                    android:scaleType="centerCrop"
                    android:background="@drawable/borda_circular_azul"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvNomePerfilPublico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Nome completo" />

                <TextView
                    android:id="@+id/tvPapelPerfilPublico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/azul_neon"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:text="Motorista" />

                <TextView
                    android:id="@+id/tvCarroPerfilPublico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    android:text="Modelo Marca • Cor • Placa" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <RatingBar
                        android:id="@+id/ratingBarPerfilPublico"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:stepSize="0.1" />

                    <TextView
                        android:id="@+id/tvMediaPerfilPublico"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#555555"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp"
                        android:text="Sem avaliações ainda" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvSemAvaliacoesPerfilPublico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/perfil_publico_sem_avaliacoes"
                android:textColor="#8899AA"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAvaliacoesPerfilPublico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
