<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_cinza_claro"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- ========== TÍTULO + LOGO + MEU PERFIL/EDITAR PERFIL ========== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvTituloCaronas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="26dp"
            android:text="@string/login_titulo"
            android:textColor="#1E90FF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSair"
            android:layout_width="76dp"
            android:layout_height="40dp"
            android:layout_alignTop="@id/tvTituloCaronas"
            android:layout_alignParentEnd="true"
            android:text="@string/sair"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/botao_azul_neon"
            android:padding="4dp" />

        <!-- Logo + Meu Perfil/Editar Perfil na mesma linha: logo do lado
             direito, os dois links à esquerda, ambos centralizados
             verticalmente nessa faixa (logo centralizada colidia com o
             texto — não sobra largura suficiente pros dois). -->
        <RelativeLayout
            android:id="@+id/rowLogoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTituloCaronas"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/ivLogoCaronas"
                android:layout_width="53dp"
                android:layout_height="35dp"
                android:layout_alignParentEnd="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_caronas"
                android:contentDescription="@string/login_titulo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMeuPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tela_botao_meu_perfil"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E90FF"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvEditarPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/tela_botao_editar_perfil"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E90FF"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

    <!-- ========== PERFIL (foto + papel/nome à esquerda, ações à direita) ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#141E90FF"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">

            <ImageView
                android:id="@+id/ivFotoPerfil"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/ic_person_default"
                android:scaleType="centerCrop"
                android:background="@drawable/borda_circular_azul" />

            <TextView
                android:id="@+id/tvPapelUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1E90FF" />

            <TextView
                android:id="@+id/tvNomeUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/carregando"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#222222" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btnProcurar"
                style="@style/BotaoAcaoCaronasVertical"
                android:text="@string/tela_botao_procurar" />

            <TextView
                android:id="@+id/btnOferecer"
                style="@style/BotaoAcaoCaronasVertical"
                android:text="@string/tela_botao_oferecer" />

            <TextView
                android:id="@+id/btnSuasViagens"
                style="@style/BotaoAcaoCaronasVertical"
                android:text="@string/tela_botao_viagens" />

            <TextView
                android:id="@+id/btnChat"
                style="@style/BotaoAcaoCaronasVertical"
                android:text="@string/tela_botao_chat" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
