<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_cinza_claro"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- ========== TÍTULO + LOGO + MEU PERFIL/EDITAR PERFIL ========== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvTituloCaronas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="26dp"
            android:text="@string/login_titulo"
            android:textColor="@color/azul_neon_escuro"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConfiguracoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/tvTituloCaronas"
            android:layout_alignParentStart="true"
            android:text="⚙️"
            android:textSize="24sp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/config_titulo" />

        <LinearLayout
            android:id="@+id/containerSairComContadores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/tvTituloCaronas"
            android:layout_alignParentEnd="true"
            android:orientation="vertical"
            android:gravity="end">

            <!-- Só aparecem pra quem está logado como motorista (ver
                 TelaCaronasActivity.carregarPerfil) — minúsculos de
                 propósito, é só um lembrete, não compete visualmente com o
                 resto do cabeçalho. -->
            <TextView
                android:id="@+id/tvContadorViagensGratis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#8899AA"
                android:visibility="gone"
                tools:text="Grátis: 7/10" />

            <TextView
                android:id="@+id/tvContadorViagensRealizadas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#8899AA"
                android:layout_marginBottom="2dp"
                android:visibility="gone"
                tools:text="Realizadas: 3" />

            <Button
                android:id="@+id/btnSair"
                android:layout_width="76dp"
                android:layout_height="40dp"
                android:text="@string/sair"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/botao_azul_neon"
                android:padding="4dp" />

        </LinearLayout>

        <!-- Logo centralizada; Meu Perfil/Editar Perfil empilhados à
             esquerda, na mesma faixa (largura de um item por vez, não
             colide com a logo centralizada). -->
        <RelativeLayout
            android:id="@+id/rowLogoPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvTituloCaronas"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/ivLogoCaronas"
                android:layout_width="53dp"
                android:layout_height="35dp"
                android:layout_centerHorizontal="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_caronas"
                android:contentDescription="@string/login_titulo" />

            <TextView
                android:id="@+id/tvMeuPerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/tela_botao_meu_perfil"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1E90FF"
                android:clickable="true"
                android:focusable="true" />

        </RelativeLayout>

    </RelativeLayout>

    <!-- ========== PERFIL (foto + papel/nome à esquerda, ações à direita) ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#141E90FF"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">

            <ImageView
                android:contentDescription="@string/cd_foto_perfil"
                android:id="@+id/ivFotoPerfil"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/ic_person_default"
                android:scaleType="centerCrop"
                android:background="@drawable/borda_circular_azul" />

            <TextView
                android:id="@+id/tvPapelUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1E90FF" />

            <TextView
                android:id="@+id/tvNomeUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/carregando"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btnMinhasOfertasOuViagens"
                    style="@style/BotaoAcaoCaronasVertical"
                    android:layout_marginTop="0dp"
                    android:text="@string/tela_botao_minhas_ofertas" />

                <TextView
                    android:id="@+id/badgeMinhasOfertasOuViagens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#D32F2F"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:visibility="gone"
                    android:elevation="4dp" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/btnProcurar"
                style="@style/BotaoAcaoCaronasVertical"
                android:text="@string/tela_botao_procurar" />

            <TextView
                android:id="@+id/btnOferecer"
                style="@style/BotaoAcaoCaronasVertical"
                android:text="@string/tela_botao_oferecer" />

            <!-- Só pro motorista (mesmo toggle de btnOferecer/btnProcurar em
                 TelaCaronasActivity.carregarPerfil) — configuração/conteúdo
                 real ainda por vir, por enquanto abre a mesma tela de
                 assinatura do acesso pago (ver AssinaturaMotoristaActivity). -->
            <TextView
                android:id="@+id/btnPagamentos"
                style="@style/BotaoAcaoCaronasVertical"
                android:text="@string/tela_botao_pagamentos" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/btnChat"
                    style="@style/BotaoAcaoCaronasVertical"
                    android:text="@string/tela_botao_chat" />

                <TextView
                    android:id="@+id/badgeChatNaoLidas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-6dp"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#D32F2F"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:visibility="gone"
                    android:elevation="4dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/btnAvaliacoes"
                style="@style/BotaoAcaoCaronasVertical"
                android:text="@string/tela_botao_avaliacoes" />

        </LinearLayout>

    </LinearLayout>

    <!-- ========== RESULTADOS (Procurar / Minhas Ofertas / Minhas Viagens / Avaliações) ========== -->
    <!-- Área compartilhada pelas 3 ações — cada uma preenche esta mesma
         área (mutuamente exclusivas por papel: motorista só usa Minhas
         Ofertas aqui, passageiro só usa Procurar/Minhas Viagens, nunca ao
         mesmo tempo). Segunda seção (tvTituloSecaoDois em diante) só é
         usada por "Minhas Ofertas" (Solicitações Recebidas) — mesmo
         conteúdo que existia em MinhasOfertasActivity, agora nesta mesma
         tela, mesmo espírito de Minhas Viagens já embutida aqui antes. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Só aparece na seção "Avaliações" (ver
                 TelaCaronasActivity.mostrarAvaliacoes) — resumo fixo acima
                 da lista de comentários (que usa a mesma
                 progressBarBusca/tvSemResultadosBusca/rvResultadosBusca das
                 outras seções, só troca o texto/adapter). -->
            <LinearLayout
                android:id="@+id/layoutResumoAvaliacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="14dp"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvViagensRealizadasAvaliacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grafite"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:text="Viagens realizadas: 0" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tela_avaliacoes_distribuicao_titulo"
                    android:textColor="@color/azul_neon"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvNota5Avaliacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#455A64"
                    android:textSize="13sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="⭐⭐⭐⭐⭐  —  0" />

                <TextView
                    android:id="@+id/tvNota4Avaliacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#455A64"
                    android:textSize="13sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="⭐⭐⭐⭐  —  0" />

                <TextView
                    android:id="@+id/tvNota3Avaliacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#455A64"
                    android:textSize="13sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="⭐⭐⭐  —  0" />

                <TextView
                    android:id="@+id/tvNota2Avaliacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#455A64"
                    android:textSize="13sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="⭐⭐  —  0" />

                <TextView
                    android:id="@+id/tvNota1Avaliacoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#455A64"
                    android:textSize="13sp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:text="⭐  —  0" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarBusca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvResumoBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:textColor="#1E90FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSemResultadosBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/procurar_sem_resultados"
                android:textColor="#8899AA"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResultadosBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTituloSecaoDois"
                style="@style/TituloSecaoCaronas"
                android:text="@string/solicitacoes_recebidas_titulo"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBarSecaoDois"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSemResultadosSecaoDois"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/solicitacoes_recebidas_vazio"
                android:textColor="#8899AA"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSecaoDois"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
