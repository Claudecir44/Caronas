<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha de "Valor de cada trecho" (ver ValoresPorTrechoUtil). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvRotuloValorTrecho"
        style="@style/RotuloCampoCaronas" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="@color/azul_neon"
        app:hintTextColor="@color/azul_neon"
        app:prefixText="💰  "
        android:hint="@string/oferecer_valor_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etValorTrecho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
