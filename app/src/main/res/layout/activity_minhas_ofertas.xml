<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_cinza_claro">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/minhas_ofertas_titulo"
        android:textColor="@color/azul_neon"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="36dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="12dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp">

            <ProgressBar
                android:id="@+id/progressBarOfertas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvSemOfertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/minhas_ofertas_vazio"
                android:textColor="#8899AA"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMinhasOfertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTituloSolicitacoesRecebidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/solicitacoes_recebidas_titulo"
                android:textColor="@color/azul_neon"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBarSolicitacoes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tvSemSolicitacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/solicitacoes_recebidas_vazio"
                android:textColor="#8899AA"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSolicitacoesRecebidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
