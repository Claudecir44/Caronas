<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/minhas_ofertas_editar_titulo"
            android:textColor="@color/azul_neon"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxStrokeColor="@color/azul_neon"
            app:hintTextColor="@color/azul_neon"
            app:prefixText="🚩  "
            android:hint="@string/oferecer_origem_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCidadeOrigemEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:boxStrokeColor="#B0BEC5"
            app:hintTextColor="#78909C"
            app:prefixText="📍  "
            android:hint="@string/oferecer_endereco_origem_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEnderecoOrigemEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/containerParadasEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/btnAdicionarParadaEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/oferecer_botao_adicionar_parada"
            android:textColor="@color/azul_neon"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:boxStrokeColor="@color/azul_neon"
            app:hintTextColor="@color/azul_neon"
            app:prefixText="🏁  "
            android:hint="@string/oferecer_destino_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCidadeDestinoEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            app:boxStrokeColor="#B0BEC5"
            app:hintTextColor="#78909C"
            app:prefixText="📍  "
            android:hint="@string/oferecer_endereco_destino_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEnderecoDestinoEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:boxStrokeColor="@color/azul_neon"
                app:hintTextColor="@color/azul_neon"
                app:prefixText="📅  "
                android:hint="@string/oferecer_escolher_data">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDataEditar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                app:boxStrokeColor="@color/azul_neon"
                app:hintTextColor="@color/azul_neon"
                app:prefixText="🕐  "
                android:hint="@string/oferecer_escolher_hora">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHoraEditar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:boxStrokeColor="@color/azul_neon"
            app:hintTextColor="@color/azul_neon"
            app:prefixText="💺  "
            android:hint="@string/oferecer_vagas_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVagasEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="1"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:boxStrokeColor="@color/azul_neon"
            app:hintTextColor="@color/azul_neon"
            app:prefixText="💰  "
            android:hint="@string/oferecer_valor_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etValorEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSalvarOferta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="@string/minhas_ofertas_botao_salvar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/botao_azul_neon" />

    </LinearLayout>
</ScrollView>
