<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@color/fundo_cinza_claro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/oferecer_titulo"
            android:textColor="@color/azul_neon"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="36dp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/oferecer_subtitulo"
            android:textColor="#8899AA"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="22dp" />

        <TextView
            style="@style/RotuloCampoCaronas"
            android:text="@string/oferecer_origem_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/azul_neon"
            app:hintTextColor="@color/azul_neon"
            app:prefixText="🚩  "
            android:hint="@string/oferecer_origem_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCidadeOrigem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/RotuloCampoCaronas"
            android:layout_marginTop="10dp"
            android:text="@string/oferecer_endereco_origem_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#B0BEC5"
            app:hintTextColor="#78909C"
            app:prefixText="📍  "
            android:hint="@string/oferecer_endereco_origem_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEnderecoOrigem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Paradas intermediárias (estilo BlaBlaCar) — fica entre a cidade
             de partida e a de chegada, no meio do trajeto (onde elas
             realmente ficam na rota). Cada linha adicionada aqui vira uma
             parada nessa ordem (ver OferecerCaronaActivity.adicionarLinhaParada). -->
        <LinearLayout
            android:id="@+id/containerParadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/btnAdicionarParada"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/oferecer_botao_adicionar_parada"
            android:textColor="@color/azul_neon"
            android:textStyle="bold"
            android:textSize="13sp"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            style="@style/RotuloCampoCaronas"
            android:layout_marginTop="4dp"
            android:text="@string/oferecer_destino_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/azul_neon"
            app:hintTextColor="@color/azul_neon"
            app:prefixText="🏁  "
            android:hint="@string/oferecer_destino_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCidadeDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/RotuloCampoCaronas"
            android:layout_marginTop="10dp"
            android:text="@string/oferecer_endereco_destino_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#B0BEC5"
            app:hintTextColor="#78909C"
            app:prefixText="📍  "
            android:hint="@string/oferecer_endereco_destino_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEnderecoDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:inputType="textCapSentences"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/RotuloCampoCaronas"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/oferecer_escolher_data" />

            <TextView
                style="@style/RotuloCampoCaronas"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/oferecer_escolher_hora" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/azul_neon"
                app:hintTextColor="@color/azul_neon"
                app:prefixText="📅  "
                android:hint="@string/oferecer_escolher_data">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tvData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="@color/azul_neon"
                app:hintTextColor="@color/azul_neon"
                app:prefixText="🕐  "
                android:hint="@string/oferecer_escolher_hora">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/tvHora"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <TextView
            style="@style/RotuloCampoCaronas"
            android:text="@string/oferecer_vagas_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/azul_neon"
            app:hintTextColor="@color/azul_neon"
            app:prefixText="💺  "
            android:hint="@string/oferecer_vagas_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etVagas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1"
                android:inputType="number"
                android:maxLength="1"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/btnCalcularSugestao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/oferecer_botao_calcular_sugestao"
            android:textColor="@color/azul_neon"
            android:textStyle="bold"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Preenchido em OferecerCaronaActivity.calcularSugestao — uma
             linha por trecho (origem->parada1, parada1->parada2, ...,
             última parada->destino) quando há paradas, senão só a linha
             única de sempre (origem->destino direto). -->
        <LinearLayout
            android:id="@+id/layoutSugestao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#141E90FF"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <TextView
            style="@style/RotuloCampoCaronas"
            android:text="@string/oferecer_valor_hint" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/azul_neon"
            app:hintTextColor="@color/azul_neon"
            app:prefixText="💰  "
            android:hint="@string/oferecer_valor_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etValorPorVaga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/oferecer_botao_publicar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:background="@drawable/botao_azul_neon"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Exigência do plano gratuito da LocationIQ (ver
             functions/index.js#autocompletarEndereco) — manter visível
             enquanto o autocomplete estiver ativo. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/autocomplete_atribuicao"
            android:textColor="#8899AA"
            android:textSize="10sp"
            android:gravity="center"
            android:autoLink="web"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
