<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza_claro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manifestacao_titulo"
            android:textColor="@color/azul_neon"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manifestacao_explicacao"
            android:textColor="#666666"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etNomeManifestacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cadastro_nome_completo"
            android:inputType="textPersonName"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etEmailManifestacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cadastro_email"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etTelefoneManifestacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cadastro_telefone"
            android:inputType="phone"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manifestacao_tipo_titulo"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgTipoManifestacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbReclamacao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/manifestacao_tipo_reclamacao"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbSugestao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/manifestacao_tipo_sugestao"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/rbDenuncia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/manifestacao_tipo_denuncia"
                android:textSize="12sp" />

        </RadioGroup>

        <EditText
            android:id="@+id/etMensagemManifestacao"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:hint="@string/manifestacao_mensagem_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:gravity="top|start"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnEnviarManifestacao"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/manifestacao_botao_enviar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_azul_neon" />

        <ProgressBar
            android:id="@+id/progressBarManifestacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
