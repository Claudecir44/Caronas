<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza_claro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_detalhes_usuario_titulo"
            android:textColor="@color/azul_neon"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="20dp" />

        <ImageView
            android:id="@+id/ivFotoDetalhesUsuario"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person_default"
            android:scaleType="centerCrop"
            android:background="@drawable/borda_circular_azul"
            android:layout_marginBottom="20dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_nome_completo"
            android:textColor="#999999"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDetalhesNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:enabled="false"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_email"
            android:textColor="#999999"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalhesEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="15sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_telefone"
            android:textColor="#999999"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDetalhesTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:enabled="false"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_detalhes_cadastrado_em"
            android:textColor="#999999"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalhesCriadoEm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="15sp"
            android:layout_marginBottom="14dp" />

        <!-- Só aparece pra motorista (ver Usuario.veiculo). -->
        <LinearLayout
            android:id="@+id/containerVeiculoDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginVertical="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_detalhes_veiculo_titulo"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etDetalhesVeiculoMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_veiculo_marca"
                android:enabled="false"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etDetalhesVeiculoModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_veiculo_modelo"
                android:enabled="false"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etDetalhesVeiculoCor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_veiculo_cor"
                android:enabled="false"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etDetalhesVeiculoPlaca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_veiculo_placa"
                android:enabled="false"
                android:layout_marginBottom="10dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnEditarSalvarDetalhes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/editar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_azul_neon"
            android:layout_marginTop="16dp" />

        <ProgressBar
            android:id="@+id/progressBarDetalhesUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
