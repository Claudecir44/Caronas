<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/ivFotoUsuarioAdmin"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person_default"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeUsuarioAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/grafite"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="Nome completo" />

            <TextView
                android:id="@+id/tvEmailUsuarioAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555555"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:text="email@exemplo.com" />

            <TextView
                android:id="@+id/tvTelefoneUsuarioAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555555"
                android:textSize="12sp"
                android:text="(00) 00000-0000" />

            <TextView
                android:id="@+id/tvVeiculoUsuarioAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/grafite"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:text="Marca Modelo — Cor — Placa AAA0A00" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
