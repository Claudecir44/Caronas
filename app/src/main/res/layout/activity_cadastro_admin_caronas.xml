<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@drawable/bg_fundo_caronas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloCadastroAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_cadastro_titulo"
            android:textColor="#1E90FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:contentDescription="@string/cd_foto_perfil"
            android:id="@+id/ivFotoAdmin"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person_default"
            android:scaleType="centerCrop"
            android:background="@drawable/borda_circular_azul" />

        <TextView
            android:id="@+id/tvSelecionarFotoAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/admin_cadastro_selecionar_foto"
            android:textColor="#1E90FF"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_cadastro_nome_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#8899AA"
            android:inputType="textPersonName"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etSobrenome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_cadastro_sobrenome_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#8899AA"
            android:inputType="textPersonName"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etEmailAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cadastro_email"
            android:textColor="#FFFFFF"
            android:textColorHint="#8899AA"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etTelefoneAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cadastro_telefone"
            android:textColor="#FFFFFF"
            android:textColorHint="#8899AA"
            android:inputType="phone"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etCpfAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/admin_cadastro_cpf_hint"
            android:textColor="#FFFFFF"
            android:textColorHint="#8899AA"
            android:inputType="number"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/layoutSenhaAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etSenhaAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_senha"
                android:textColor="#FFFFFF"
                android:textColorHint="#8899AA"
                android:inputType="textPassword"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etConfirmarSenhaAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_confirmar_senha"
                android:textColor="#FFFFFF"
                android:textColorHint="#8899AA"
                android:inputType="textPassword"
                android:layout_marginBottom="20dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#141E2A"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_cadastro_autorizacao_titulo"
                android:textColor="#1E90FF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etSenhaMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/admin_cadastro_senha_autorizacao_hint"
                android:textColor="#FFFFFF"
                android:textColorHint="#8899AA"
                android:inputType="textPassword" />

        </LinearLayout>

        <Button
            android:id="@+id/btnCadastrarAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_cadastro_botao"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_azul_neon"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnExcluirAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_editar_excluir_botao"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#D32F2F"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
