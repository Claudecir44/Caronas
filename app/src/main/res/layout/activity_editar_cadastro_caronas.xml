<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@drawable/bg_fundo_caronas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editar_titulo"
            android:textColor="#1E90FF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:id="@+id/ivFotoPerfil"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_person_default"
            android:scaleType="centerCrop"
            android:background="@drawable/borda_circular_azul" />

        <TextView
            android:id="@+id/tvSelecionarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/cadastro_selecionar_foto"
            android:textColor="#1E90FF"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etNomeCompleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cadastro_nome_completo"
            android:textColor="#FFFFFF"
            android:textColorHint="#8899AA"
            android:inputType="textPersonName"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cadastro_email"
            android:textColor="#8899AA"
            android:textColorHint="#8899AA"
            android:inputType="textEmailAddress"
            android:enabled="false"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cadastro_telefone"
            android:textColor="#FFFFFF"
            android:textColorHint="#8899AA"
            android:inputType="phone"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbSouMotorista"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cadastro_sou_motorista"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:buttonTint="#1E90FF"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutVeiculo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#141E2A"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cadastro_veiculo_titulo"
                android:textColor="#1E90FF"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etVeiculoModelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_veiculo_modelo"
                android:textColor="#FFFFFF"
                android:textColorHint="#8899AA"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etVeiculoMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_veiculo_marca"
                android:textColor="#FFFFFF"
                android:textColorHint="#8899AA"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etVeiculoCor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_veiculo_cor"
                android:textColor="#FFFFFF"
                android:textColorHint="#8899AA"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etVeiculoPlaca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/cadastro_veiculo_placa"
                android:textColor="#FFFFFF"
                android:textColorHint="#8899AA" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editar_botao_salvar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_azul_neon"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnExcluirCadastro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editar_botao_excluir"
            android:textColor="#FF5252"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
