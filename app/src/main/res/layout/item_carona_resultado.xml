<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvRotaResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1E90FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="Origem → Destino" />

        <TextView
            android:id="@+id/tvDataHoraResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:text="dd/MM/yyyy às HH:mm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:id="@+id/ivFotoMotoristaResultado"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_person_default"
                android:scaleType="centerCrop"
                android:background="@drawable/borda_circular_azul"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvNomeMotoristaResultado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#222222"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Nome do motorista" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvVagasResultado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#555555"
                android:textSize="12sp"
                android:text="Vagas: 0" />

            <TextView
                android:id="@+id/tvValorResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1E90FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="R$ 0,00 /vaga" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSolicitarResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/procurar_botao_solicitar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/botao_azul_neon" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
