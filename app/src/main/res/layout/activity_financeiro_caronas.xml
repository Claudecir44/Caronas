<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/fundo_cinza_claro">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/financeiro_titulo"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/azul_neon_escuro"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Gera um PDF com nome/valor/data/validade de cada pagante de um mês
         específico, mais o resumo por valor pago e o total geral (ver
         FinanceiroCaronasActivity.gerarRelatorioMensal/PdfUtil.kt). -->
    <Button
        android:id="@+id/btnGerarRelatorio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/financeiro_gerar_relatorio_btn"
        android:background="@drawable/botao_verde_agua"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Filtros -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/financeiro_periodo_label"
                android:textSize="16sp"
                android:textColor="#070707"
                android:layout_marginEnd="8dp" />

            <Spinner
                android:id="@+id/spinnerPeriodo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:entries="@array/periodos_array"
                android:background="@drawable/borda_parada_input"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnFiltrar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/financeiro_botao_filtrar"
                android:background="@drawable/botao_azul_neon"
                android:textColor="#FFFFFF"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDataPersonalizada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/financeiro_data_inicial"
                    android:textSize="14sp"
                    android:textColor="#333"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etDataInicial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="dd/MM/aaaa"
                    android:inputType="number"
                    android:maxLength="10"
                    android:background="@drawable/borda_parada_input"
                    android:padding="12dp"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/financeiro_data_final"
                    android:textSize="14sp"
                    android:textColor="#333"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etDataFinal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="dd/MM/aaaa"
                    android:inputType="number"
                    android:maxLength="10"
                    android:background="@drawable/borda_parada_input"
                    android:padding="12dp"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Cards de resumo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_relatorio"
            android:padding="12dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/financeiro_total_pagamentos"
                android:textSize="12sp"
                android:textColor="#555" />

            <TextView
                android:id="@+id/tvTotalPagamentos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/azul_neon_escuro" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_relatorio"
            android:padding="12dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/financeiro_motoristas_unicos"
                android:textSize="12sp"
                android:textColor="#555" />

            <TextView
                android:id="@+id/tvMotoristasUnicos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/azul_neon_escuro" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_relatorio"
            android:padding="12dp"
            android:layout_marginStart="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/financeiro_total_arrecadado"
                android:textSize="12sp"
                android:textColor="#555" />

            <TextView
                android:id="@+id/tvTotalArrecadado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/azul_neon_escuro" />
        </LinearLayout>
    </LinearLayout>

    <!-- Lista de pagamentos -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/financeiro_detalhes_titulo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#070707"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPagamentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/financeiro_sem_dados"
        android:textSize="14sp"
        android:textColor="#888"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

</LinearLayout>
