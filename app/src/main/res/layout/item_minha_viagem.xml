<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/headerMinhaViagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRotaViagem"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="Origem → Destino" />

                <TextView
                    android:id="@+id/tvStatusViagem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#1E90FF"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginEnd="8dp"
                    android:text="SOLICITADA" />

                <TextView
                    android:id="@+id/tvExpandIconViagem"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textSize="14sp"
                    android:textColor="#1E90FF" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDataHoraViagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555555"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:text="dd/MM/yyyy às HH:mm" />

            <!-- Tempo aproximado do trecho (TempoViagemUtil) — mesma
                 fonte/cor da data, só em negrito. -->
            <TextView
                android:id="@+id/tvTempoViagemViagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555555"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:text="Tempo aproximado: 0h00" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/corpoExpandidoViagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="10dp" />

            <!-- Só aparece quando a viagem já foi confirmada pelo motorista
                 (ver MinhaViagemAdapter) — antes disso não faz sentido
                 mostrar quem vai buscar o passageiro. -->
            <LinearLayout
                android:id="@+id/layoutMotoristaViagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|start"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <ImageView
                    android:contentDescription="@string/cd_foto_perfil"
                    android:id="@+id/ivFotoMotoristaViagem"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_person_default"
                    android:scaleType="centerCrop"
                    android:background="@drawable/borda_circular_azul"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNomeMotoristaViagem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:text="Nome do motorista" />

                    <TextView
                        android:id="@+id/tvCarroMotoristaViagem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#777777"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"
                        android:text="Modelo Marca • Cor • Placa" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tvValorPagoViagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#1E90FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:text="R$ 0,00" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnChatViagem"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/solicitacoes_botao_chat"
                    android:textSize="12sp"
                    android:textColor="#1E90FF"
                    android:textStyle="bold"
                    android:background="#141E90FF" />

                <Button
                    android:id="@+id/btnCancelarViagem"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/minhas_viagens_botao_cancelar"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#D32F2F" />

                <!-- Só aparece quando a viagem foi confirmada E já ocorreu
                     (ver MinhaViagemAdapter) — mesmo espaço do botão
                     Cancelar, nunca os dois juntos. -->
                <Button
                    android:id="@+id/btnAvaliarViagem"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/avaliar_botao"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/botao_azul_neon"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
