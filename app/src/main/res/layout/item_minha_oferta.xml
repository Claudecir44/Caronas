<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvRotaOferta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#1E90FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="Origem → Destino" />

            <TextView
                android:id="@+id/tvStatusOferta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#1E90FF"
                android:background="#141E90FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="ATIVA" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvDataHoraOferta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="10dp"
            android:text="dd/MM/yyyy às HH:mm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvVagasOferta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#555555"
                android:textSize="12sp"
                android:text="Vagas: 0" />

            <TextView
                android:id="@+id/tvValorOferta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1E90FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:text="R$ 0,00 /vaga" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditarOferta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:text="@string/minhas_ofertas_botao_editar"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/botao_azul_neon" />

            <Button
                android:id="@+id/btnExcluirOferta"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:text="@string/minhas_ofertas_botao_excluir"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#D32F2F" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
