<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_cinza_claro"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- ========== TÍTULO + SAIR (mesmo formato da tela do usuário) ========== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_titulo_dashboard"
                android:textColor="#000000"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_titulo"
                android:textColor="@color/azul_neon_escuro"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSair"
            android:layout_width="76dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="26dp"
            android:text="@string/sair"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/botao_azul_neon"
            android:padding="4dp" />

    </RelativeLayout>

    <!-- ========== EDITAR PERFIL (fora do box azul, mesmo espírito do "Meu
         Perfil" da tela do usuário) ========== -->
    <TextView
        android:id="@+id/tvEditarPerfilAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/admin_botao_editar_perfil"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#1E90FF"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="8dp" />

    <!-- ========== PERFIL DO ADMIN (foto + nome à esquerda, ações à direita) ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#141E90FF"
        android:padding="10dp">

        <!-- Linha de cima: foto+nome (mesmo espaço de sempre) e Motoristas/
             Passageiros empilhados — igual era antes de existir a seção
             Sugestões, pra foto/nome não ficarem espremidos. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <ImageView
                    android:id="@+id/ivFotoAdminLogado"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:src="@drawable/ic_person_default"
                    android:scaleType="centerCrop"
                    android:background="@drawable/borda_circular_azul"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvAdminNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/carregando"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnMotoristas"
                    style="@style/BotaoAcaoCaronasVertical"
                    android:text="@string/admin_botao_motoristas" />

                <TextView
                    android:id="@+id/btnPassageiros"
                    style="@style/BotaoAcaoCaronasVertical"
                    android:text="@string/admin_botao_passageiros" />

                <!-- Histórico de cobranças dos R$15,99/30 dias do motorista
                     (ver AdministracaoCaronasActivity.mostrarFinanceiro) —
                     mesmo tamanho/estilo de Motoristas/Passageiros, empilhado
                     logo abaixo do Passageiros. -->
                <TextView
                    android:id="@+id/btnFinanceiro"
                    style="@style/BotaoAcaoCaronasVertical"
                    android:text="@string/admin_botao_financeiro" />

            </LinearLayout>

        </LinearLayout>

        <!-- Linha de baixo: Sugestões/Mensagens/Viagens ocupando a largura
             inteira da tela (peso igual pros três) — fora da linha de cima
             de propósito, senão volta a espremer a foto/nome. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/btnManifestacoes"
                    style="@style/BotaoAcaoCaronasVertical"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="0dp"
                    android:text="@string/admin_botao_manifestacoes" />

                <!-- Badge de reclamações/sugestões/denúncias pendentes (ver
                     AdministracaoCaronasActivity.escutarBadgeManifestacoes) —
                     mesmo estilo visual do badge de "Minhas Ofertas"/"Chat"
                     na tela do usuário comum (activity_tela_caronas.xml). -->
                <TextView
                    android:id="@+id/badgeManifestacoes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-4dp"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#D32F2F"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:visibility="gone"
                    android:elevation="4dp" />

            </FrameLayout>

            <TextView
                android:id="@+id/btnMensagens"
                style="@style/BotaoAcaoCaronasVertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/admin_botao_mensagens" />

            <TextView
                android:id="@+id/btnViagens"
                style="@style/BotaoAcaoCaronasVertical"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/admin_botao_viagens" />

        </LinearLayout>

    </LinearLayout>

    <!-- ========== LISTA DA SEÇÃO SELECIONADA (mesma tela, sem abrir outra
         Activity — mesmo espírito dos resultados de busca da tela do
         usuário, logo abaixo do box azul) ========== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <!-- Só aparece na seção "Mensagens" (ver
                 AdministracaoCaronasActivity.abrirBuscaMensagens) — busca
                 por nome completo, telefone ou e-mail pra achar de quem ver
                 as conversas. -->
            <LinearLayout
                android:id="@+id/containerBuscaMensagens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etBuscaMensagens"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/admin_mensagens_busca_hint"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:maxLines="1"
                    android:textColor="@color/grafite"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnBuscarMensagens"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_mensagens_busca_botao"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/botao_azul_neon" />

            </LinearLayout>

            <!-- Só aparece na seção "Financeiro" (ver
                 AdministracaoCaronasActivity.mostrarFinanceiro) — filtro de
                 período + resumo, acima da lista de pagamentos que usa o
                 mesmo rvSecaoAdmin/tvVazioSecaoAdmin de sempre. -->
            <LinearLayout
                android:id="@+id/containerFiltroFinanceiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Spinner
                        android:id="@+id/spinnerPeriodoFinanceiro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:entries="@array/periodos_array"
                        android:background="@drawable/borda_parada_input"
                        android:padding="8dp" />

                    <Button
                        android:id="@+id/btnFiltrarFinanceiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/financeiro_botao_filtrar"
                        android:background="@drawable/botao_azul_neon"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutDataPersonalizadaFinanceiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <EditText
                        android:id="@+id/etDataInicialFinanceiro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/financeiro_data_inicial"
                        android:inputType="number"
                        android:maxLength="10"
                        android:background="@drawable/borda_parada_input"
                        android:padding="10dp"
                        android:textSize="14sp"
                        android:layout_marginEnd="6dp" />

                    <EditText
                        android:id="@+id/etDataFinalFinanceiro"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/financeiro_data_final"
                        android:inputType="number"
                        android:maxLength="10"
                        android:background="@drawable/borda_parada_input"
                        android:padding="10dp"
                        android:textSize="14sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_relatorio"
                        android:padding="10dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/financeiro_total_pagamentos"
                            android:textSize="10sp"
                            android:textColor="#555" />

                        <TextView
                            android:id="@+id/tvTotalPagamentosFinanceiro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/azul_neon_escuro" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_relatorio"
                        android:padding="10dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/financeiro_motoristas_unicos"
                            android:textSize="10sp"
                            android:textColor="#555" />

                        <TextView
                            android:id="@+id/tvMotoristasUnicosFinanceiro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/azul_neon_escuro" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/card_relatorio"
                        android:padding="10dp"
                        android:layout_marginStart="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/financeiro_total_arrecadado"
                            android:textSize="10sp"
                            android:textColor="#555" />

                        <TextView
                            android:id="@+id/tvTotalArrecadadoFinanceiro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 0,00"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/azul_neon_escuro" />
                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btnGerarRelatorioFinanceiro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/financeiro_gerar_relatorio_btn"
                    android:background="@drawable/botao_verde_agua"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:padding="10dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/tvTituloSecaoAdmin"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textColor="@color/azul_neon"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Total de motoristas/passageiros (ver
                     AdministracaoCaronasActivity.mostrarMotoristas/
                     mostrarPassageiros) — só preenchido/visível nessas duas
                     seções, vazio nas outras. -->
                <TextView
                    android:id="@+id/tvContadorSecaoAdmin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@color/azul_neon_escuro"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:visibility="gone" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBarSecaoAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVazioSecaoAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#8899AA"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSecaoAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Só aparece na seção "Sugestões" (Reclamações/Sugestões/
                 Denúncias) — alterna entre a lista ativa e a de arquivados
                 (ver AdministracaoCaronasActivity.mostrarManifestacoes/
                 mostrarManifestacoesArquivadas). -->
            <Button
                android:id="@+id/btnArquivadosManifestacoes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="@string/admin_manifestacoes_botao_arquivados"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="@color/grafite"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
