<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fechado: tipo, status, nome e data. -->
        <LinearLayout
            android:id="@+id/headerManifestacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTipoManifestacao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1E90FF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:text="📝 Reclamação" />

                <TextView
                    android:id="@+id/tvExpandIconManifestacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textSize="14sp"
                    android:textColor="#1E90FF" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvNomeManifestacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:text="Nome do autor" />

            <TextView
                android:id="@+id/tvDataManifestacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:text="dd/MM/yyyy às HH:mm" />

            <TextView
                android:id="@+id/tvStatusManifestacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#00897B"
                android:layout_marginTop="4dp"
                android:text="— Sem resposta" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/corpoExpandidoManifestacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvContatoManifestacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555555"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"
                android:text="email@exemplo.com — (00) 00000-0000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mensagem:"
                android:textColor="#999999"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMensagemManifestacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#333333"
                android:textSize="13sp"
                android:layout_marginBottom="10dp"
                android:text="Mensagem do usuário." />

            <LinearLayout
                android:id="@+id/containerRespostaManifestacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F2F2F7"
                android:padding="8dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Resposta enviada:"
                    android:textColor="#999999"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRespostaManifestacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#333333"
                    android:textSize="13sp"
                    android:text="Resposta." />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnResponderManifestacao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/admin_manifestacoes_botao_responder"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/botao_azul_neon" />

                <Button
                    android:id="@+id/btnArquivarManifestacao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:layout_marginEnd="4dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/admin_manifestacoes_botao_arquivar"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@color/grafite" />

                <Button
                    android:id="@+id/btnExcluirManifestacao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="0dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/excluir"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#D32F2F" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
