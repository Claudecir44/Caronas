<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootChatCarona"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_cinza_claro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#141E90FF"
        android:padding="12dp"
        android:paddingTop="36dp">

        <TextView
            android:id="@+id/tvNomeOutroChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#1E90FF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="Nome" />

        <TextView
            android:id="@+id/tvRotaChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#555555"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:text="Origem → Destino" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMensagensChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- Chat cancelado/encerrado (ver ChatUtil): no lugar do campo de
         mensagem, só o aviso — as mensagens acima continuam visíveis. -->
    <TextView
        android:id="@+id/tvAvisoChatFechado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:gravity="center"
        android:textColor="#B71C1C"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutEntradaMensagemChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="8dp">

        <EditText
            android:id="@+id/etMensagemChat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/chat_carona_hint_mensagem"
            android:textColor="#000000"
            android:textColorHint="#999999"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:background="@android:drawable/editbox_background"
            android:padding="10dp" />

        <Button
            android:id="@+id/btnEnviarChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/chat_carona_botao_enviar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/botao_azul_neon" />

    </LinearLayout>

</LinearLayout>
