<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo_cinza_claro"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_titulo"
        android:textColor="@color/azul_neon"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="36dp"
        android:paddingBottom="28dp" />

    <Button
        android:id="@+id/btnConfigTermos"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/config_botao_termos"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/botao_azul_neon"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnConfigEditarPerfil"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/config_botao_editar_perfil"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/botao_azul_neon" />

</LinearLayout>
