<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_cinza_claro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_titulo"
            android:textColor="@color/azul_neon"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="28dp"
            android:paddingBottom="28dp" />

        <!-- Só pro motorista (visibilidade decidida em
             ConfiguracoesCaronasActivity) — abre o checkout do acesso pago
             (R$15,99 = 30 dias) e mostra o status logo abaixo do título. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardConfigPagamentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/btnConfigPagamentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_config"
                    android:text="💳"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/config_botao_pagamentos"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvConfigPagamentosStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#B0BEC5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/btnConfigTermos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_config"
                    android:text="📄"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_botao_termos"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#B0BEC5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Só no modo admin (ConfiguracoesCaronasActivity.EXTRA_MODO_ADMIN):
             guia de como monitorar e ajustar o app, logo abaixo dos Termos. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardConfigOrientacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/btnConfigOrientacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_config"
                    android:text="🧭"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_botao_orientacoes"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#B0BEC5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Só no modo admin: gera os relatórios administrativos do app
             (usuários, viagens, financeiro, avaliações, manifestações,
             administração) — ver RelatoriosCaronasActivity. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardConfigRelatorios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/btnConfigRelatorios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_config"
                    android:text="📊"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/relatorios_titulo"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#B0BEC5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Só no modo admin, e só pra quem tem a permissão
             "administradores" (ver ConfiguracoesCaronasActivity
             .aplicarPermissoesAdmin): cria/edita/exclui outros admins e
             colaboradores, com permissões granulares — ver
             GerenciarAdministradoresCaronasActivity. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardConfigAdministracao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/btnConfigAdministracao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_config"
                    android:text="👑"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/gerenciar_admins_titulo"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#B0BEC5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Só no modo admin, e só pra quem tem a permissão "mensagens" —
             reabre AdministracaoCaronasActivity direto na seção Mensagens
             (ver EXTRA_ABRIR_SECAO), reaproveitando a mesma seção inline do
             dashboard em vez de duplicar a UI aqui. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardConfigMensagens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/btnConfigMensagens"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_config"
                    android:text="💬"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_botao_ver_mensagens"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#B0BEC5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Só no modo admin, e só pra quem tem a permissão "financeiro" —
             reabre AdministracaoCaronasActivity direto na seção Financeiro
             (ver EXTRA_ABRIR_SECAO/SECAO_FINANCEIRO), mesmo espírito do card
             "Ver Mensagens" acima. Antes esse botão ficava no dashboard
             principal (pilha ao lado da foto); saiu de lá pra abrir espaço
             pro Viagens, que veio pro lugar dele. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardConfigFinanceiro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/btnConfigFinanceiro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_config"
                    android:text="💰"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/admin_botao_ver_financeiro"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#B0BEC5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardConfigManifestacoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:id="@+id/btnConfigManifestacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_config"
                    android:text="📝"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginEnd="14dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_botao_manifestacoes"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textSize="22sp"
                    android:textColor="#B0BEC5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Pequeno, alinhado à direita, logo depois dos cards — fica
             sempre visível no fluxo normal da tela. Antes ficava fixo no
             canto absoluto da tela (FrameLayout + gravity bottom|end) e
             sumia atrás da barra de navegação do sistema em alguns
             aparelhos; essa tela não trata insets/edge-to-edge, então
             evitar ancorar no fundo absoluto é o jeito seguro. -->
        <TextView
            android:id="@+id/btnVoltarConfig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="20dp"
            android:text="@string/voltar"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/botao_azul_neon"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
