<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Fechado: só rota, status e data — nome/foto do passageiro só
             aparecem ao abrir (ver corpoExpandidoSolicitacao). -->
        <LinearLayout
            android:id="@+id/headerSolicitacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRotaSolicitacao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#1E90FF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="Origem → Destino" />

                <TextView
                    android:id="@+id/tvStatusSolicitacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#1E90FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:layout_marginEnd="8dp"
                    android:text="SOLICITADA" />

                <TextView
                    android:id="@+id/tvExpandIconSolicitacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textSize="14sp"
                    android:textColor="#1E90FF" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDataHoraSolicitacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#555555"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:text="dd/MM/yyyy às HH:mm" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/corpoExpandidoSolicitacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivFotoPassageiro"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_person_default"
                    android:scaleType="centerCrop"
                    android:background="@drawable/borda_circular_azul"
                    android:layout_marginEnd="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tela_papel_passageiro"
                        android:textColor="#000000"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvNomePassageiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:text="Nome do passageiro" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnConfirmarSolicitacao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/solicitacoes_botao_confirmar"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/botao_azul_neon" />

                <!-- Só aparece se a viagem já foi confirmada e ainda não
                     ocorreu (ver SolicitacaoRecebidaAdapter) — o motorista
                     desiste de uma viagem que já tinha aceitado; diferente
                     de excluir (que apaga o registro sem avisar ninguém),
                     aqui o passageiro é notificado. -->
                <Button
                    android:id="@+id/btnCancelarSolicitacao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/cancelar"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="#D32F2F"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnChatSolicitacao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/solicitacoes_botao_chat"
                    android:textSize="12sp"
                    android:textColor="#1E90FF"
                    android:textStyle="bold"
                    android:background="#141E90FF" />

                <!-- Só aparece quando a viagem foi confirmada E já ocorreu
                     (ver SolicitacaoRecebidaAdapter). -->
                <Button
                    android:id="@+id/btnAvaliarSolicitacao"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/avaliar_botao"
                    android:textSize="12sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:background="@drawable/botao_azul_neon"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
